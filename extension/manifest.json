{
  "manifest_version": 3,
  "name": "CookieExplainer",
  "version": "2.2.0",
  "description": "AI-Powered Privacy Assistant & Autonomous Cookie Blocker",
  "permissions": [
    "cookies",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "CookieExplainer Panelini Aç/Kapat"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}